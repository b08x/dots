i() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<'HELP'
Usage: i [DIRECTORY]

Interactive hierarchical image browser & VLM annotator powered by fzf, imv, and Kitty.

Features:
  - Nested folder drill-down by default (prevents overwhelming flat lists)
  - Toggle flat/recursive image search on demand (Ctrl-F)
  - Native high-res Kitty graphics preview with fallback
  - Vision-Language Model (VLM/AGI) screenshot annotation sidecars (Ctrl-A)
  - Markdown preview of VLM annotations via glow / bat

Keybindings:
  Enter       Drill down into folder / Open image(s) in imv
  Tab         Select / deselect multiple items
  Ctrl-F      Toggle Hierarchical (Folders) vs Flat (Recursive) search
  Ctrl-H / ⯇  Go up to parent directory
  Ctrl-A      Annotate selected image(s) with VLM (writes <file>.md sidecar)
  Ctrl-Y      Copy escaped path(s) to system clipboard
  Ctrl-O      Open parent folder in GUI file manager
  Ctrl-D      Delete selected image(s) & sidecars (with confirmation)
  Ctrl-R      Reload current directory
  Esc / ^C    Exit
HELP
    return 0
  fi

  local start_dir="${1:-.}"
  start_dir="$(realpath "$start_dir" 2>/dev/null || printf "%s" "$start_dir")"

  # Temporary state directory for interactive session
  local state_dir
  state_dir="$(mktemp -d "${TMPDIR:-/tmp}/fzf-i-XXXXXX")" || return 1
  trap 'rm -rf "$state_dir"' EXIT INT TERM

  printf "%s" "$start_dir" > "$state_dir/cwd"
  printf "tree" > "$state_dir/mode"

  # Helper: List generator
  cat << 'EOF' > "$state_dir/list.sh"
#!/usr/bin/env bash
state_dir="$1"
cwd=$(cat "$state_dir/cwd" 2>/dev/null || echo ".")
mode=$(cat "$state_dir/mode" 2>/dev/null || echo "tree")
img_exts=(-e png -e jpg -e jpeg -e webp -e gif -e bmp -e svg -e tiff -e tif -e avif -e ico -e heic -e hdr)

if [ "$mode" = "tree" ]; then
    if [ "$cwd" != "/" ]; then
        parent=$(dirname "$cwd")
        printf "📁  ../\t%s\tDIR\n" "$parent"
    fi

    while IFS= read -r d; do
        [ -n "$d" ] || continue
        bname=$(basename "$d")
        printf "📁  %s/\t%s\tDIR\n" "$bname" "$d"
    done < <(fd -t d --min-depth 1 --max-depth 1 . "$cwd" 2>/dev/null | sort -f)

    while IFS= read -r f; do
        [ -n "$f" ] || continue
        bname=$(basename "$f")
        if [ -f "${f}.md" ]; then
            printf "🖼️   %s  \033[1;35m[AI]\033[0m\t%s\tIMG\n" "$bname" "$f"
        else
            printf "🖼️   %s\t%s\tIMG\n" "$bname" "$f"
        fi
    done < <(fd -t f "${img_exts[@]}" --min-depth 1 --max-depth 1 . "$cwd" 2>/dev/null | sort -f)
else
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        rel="${f#$cwd/}"
        if [ -f "${f}.md" ]; then
            printf "🖼️   %s  \033[1;35m[AI]\033[0m\t%s\tIMG\n" "$rel" "$f"
        else
            printf "🖼️   %s\t%s\tIMG\n" "$rel" "$f"
        fi
    done < <(fd -t f "${img_exts[@]}" . "$cwd" 2>/dev/null | sort -f)
fi
EOF
  chmod +x "$state_dir/list.sh"

  # Helper: Action on Enter
  cat << 'EOF' > "$state_dir/action.sh"
#!/usr/bin/env bash
state_dir="$1"
sel_path="$2"
sel_type="$3"

if [ "$sel_type" = "DIR" ]; then
    target=$(realpath -m "$sel_path" 2>/dev/null)
    if [ -d "$target" ]; then
        echo "$target" > "$state_dir/cwd"
        bname=$(basename "$target")
        [ "$target" = "/" ] && bname="/"
        echo "reload(\"$state_dir/list.sh\" \"$state_dir\")+clear-query+change-prompt( 󰋩 [${bname}] ❯ )"
    fi
else
    echo "execute(imv -- {+2})"
fi
EOF
  chmod +x "$state_dir/action.sh"

  # Helper: Up directory (Ctrl-H / Alt-Left)
  cat << 'EOF' > "$state_dir/up.sh"
#!/usr/bin/env bash
state_dir="$1"
cwd=$(cat "$state_dir/cwd" 2>/dev/null || echo ".")
target=$(realpath -m "$cwd/.." 2>/dev/null)
if [ -d "$target" ]; then
    echo "$target" > "$state_dir/cwd"
    bname=$(basename "$target")
    [ "$target" = "/" ] && bname="/"
    echo "reload(\"$state_dir/list.sh\" \"$state_dir\")+clear-query+change-prompt( 󰋩 [${bname}] ❯ )"
fi
EOF
  chmod +x "$state_dir/up.sh"

  # Helper: Toggle Tree vs Flat mode (Ctrl-F)
  cat << 'EOF' > "$state_dir/toggle.sh"
#!/usr/bin/env bash
state_dir="$1"
mode=$(cat "$state_dir/mode" 2>/dev/null || echo "tree")
if [ "$mode" = "tree" ]; then
    echo "flat" > "$state_dir/mode"
    new_label=" 󰋩 Images [Flat/Recursive] "
else
    echo "tree" > "$state_dir/mode"
    new_label=" 󰋩 Images [Folders] "
fi
echo "reload(\"$state_dir/list.sh\" \"$state_dir\")+change-border-label($new_label)"
EOF
  chmod +x "$state_dir/toggle.sh"

  # Helper: High-res Preview
  cat << 'EOF' > "$state_dir/preview.sh"
#!/usr/bin/env bash
state_dir="$1"
file="$2"
type="$3"

[ -e "$file" ] || exit 0

cols="${FZF_PREVIEW_COLUMNS:-80}"
lines="${FZF_PREVIEW_LINES:-40}"

if [ "$type" = "DIR" ] || [ -d "$file" ]; then
    if [[ -n "$KITTY_WINDOW_ID" || "$TERM" == *kitty* ]] && command -v kitty >/dev/null 2>&1; then
        kitty +kitten icat --clear 2>/dev/null
    fi

    printf " \033[1;34m📁 \033[1;37m%s\033[0m\n" "$file"
    printf "\033[2m"
    printf "─%.0s" $(seq 1 "$cols")
    printf "\033[0m\n"

    img_exts=(-e png -e jpg -e jpeg -e webp -e gif -e bmp -e svg -e tiff -e tif -e avif -e ico -e heic -e hdr)
    dircount=$(fd -t d --min-depth 1 --max-depth 1 . "$file" 2>/dev/null | wc -l)
    imgcount=$(fd -t f "${img_exts[@]}" --min-depth 1 --max-depth 1 . "$file" 2>/dev/null | wc -l)
    totalimg=$(fd -t f "${img_exts[@]}" . "$file" 2>/dev/null | wc -l)
    dirsize=$(du -sh "$file" 2>/dev/null | awk '{print $1}')

    printf " \033[1;33m󰉋\033[0m %d subfolder(s)  \033[1;34m󰋩\033[0m %d image(s) (%d nested)  \033[1;32m󰉉\033[0m %s\n\n" "$dircount" "$imgcount" "$totalimg" "$dirsize"

    if command -v tree >/dev/null 2>&1; then
        tree -C -L 2 --noreport "$file" 2>/dev/null | head -n $(( lines - 8 ))
    else
        ls -lhp --color=always "$file" 2>/dev/null | head -n $(( lines - 8 ))
    fi
    exit 0
fi

# Render image preview
sidecar="${file}.md"
has_sidecar=0
[ -f "$sidecar" ] && has_sidecar=1

if [ "$has_sidecar" -eq 1 ]; then
    img_lines=$(( lines * 42 / 100 ))
    [ "$img_lines" -lt 4 ] && img_lines=4
else
    img_lines=$(( lines > 14 ? lines - 7 : lines / 2 ))
    [ "$img_lines" -lt 4 ] && img_lines=4
fi
dim="${cols}x${img_lines}"

rendered=0
if [[ -n "$KITTY_WINDOW_ID" || "$TERM" == *kitty* ]] && command -v kitty >/dev/null 2>&1; then
    if kitty +kitten icat --clear \
      --use-window-size="${cols},${lines},$(( cols * 10 )),$(( lines * 20 ))" \
      --transfer-mode=file --stdin=no \
      --place="${dim}@0x0" "$file" 2>/dev/null; then
        for ((i=0; i<img_lines; i++)); do
            printf "\n"
        done
        rendered=1
    fi
fi

if [ "$rendered" -eq 0 ] && command -v chafa >/dev/null 2>&1; then
    chafa -s "$dim" -f symbols --symbols=all --color-space=din99d --work=9 "$file" 2>/dev/null
fi

printf "\033[2m"
printf "─%.0s" $(seq 1 "$cols")
printf "\033[0m\n"

# Filename & Image Metadata
printf " \033[1;36m󰋩 \033[1;37m%s\033[0m\n" "${file##*/}"
if command -v identify >/dev/null 2>&1; then
    info=$(identify -format "%w %h %m" "$file" 2>/dev/null)
    sz=$(ls -lh "$file" 2>/dev/null | awk '{print $5}')
    if [ -n "$info" ]; then
        read -r w h fmt <<< "$info"
        printf " \033[1;34m󰕦\033[0m %sx%s (%s)  \033[1;32m󰉉\033[0m %s\n" "$w" "$h" "$fmt" "$sz"
    else
        printf " \033[1;32m󰉉\033[0m %s\n" "$sz"
    fi
else
    printf " \033[1;32m󰉉\033[0m %s\n" "$(ls -lh "$file" 2>/dev/null | awk '{print $5}')"
fi

# VLM Annotation sidecar display
if [ "$has_sidecar" -eq 1 ]; then
    printf "\033[2m"
    printf "─%.0s" $(seq 1 "$cols")
    printf "\033[0m\n"
    printf " \033[1;35m🤖 VLM Annotation\033[0m \033[2m(${file##*/}.md)\033[0m\n\n"
    if command -v glow >/dev/null 2>&1; then
        glow -s dark -w "$cols" "$sidecar" 2>/dev/null
    elif command -v bat >/dev/null 2>&1; then
        bat --color=always --style=plain "$sidecar" 2>/dev/null
    else
        cat "$sidecar"
    fi
else
    printf "\n \033[2;37m󰋼 No annotation yet · Press \033[1;33m[Ctrl-A]\033[2;37m to annotate with VLM\033[0m\n"
fi
EOF
  chmod +x "$state_dir/preview.sh"

  local clip_cmd='
    args=()
    for f in "$@"; do
      args+=("$(printf "%q" "$f")")
    done
    str="${args[*]}"
    if command -v wl-copy >/dev/null 2>&1; then
      printf "%s" "$str" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
      printf "%s" "$str" | xclip -selection clipboard
    fi
  '

  local delete_cmd='
    for f in "$@"; do
      rm -i -- "$f"
      if [ -f "${f}.md" ]; then
        rm -i -- "${f}.md"
      fi
    done
  '

  local start_basename
  start_basename="$(basename "$start_dir")"
  [ "$start_dir" = "/" ] && start_basename="/"

  local header_str=$'  \e[1;32m󰐊 [Enter]\e[0m Open/Drill  \e[1;33m󰉋 [Ctrl-F]\e[0m Folders/Flat  \e[1;35m🤖 [Ctrl-A]\e[0m Annotate  \e[1;34m󰅍 [Ctrl-Y]\e[0m Copy  \e[1;31m󰆴 [Ctrl-D]\e[0m Delete\n'

  "$state_dir/list.sh" "$state_dir" | fzf \
    --multi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --layout=reverse \
    --border=rounded \
    --border-label=" 󰋩 Images [Folders] " \
    --border-label-pos=2 \
    --prompt=" 󰋩 [${start_basename}] ❯ " \
    --pointer="▶" \
    --marker="✓" \
    --info=inline-right \
    --header="$header_str" \
    --preview-window="right,55%,border-rounded" \
    --preview-label=" 󰋩 Preview & Annotation " \
    --preview-label-pos=2 \
    --preview "\"$state_dir/preview.sh\" \"$state_dir\" {2} {3}" \
    --bind "enter:transform(\"$state_dir/action.sh\" \"$state_dir\" {2} {3})" \
    --bind "ctrl-h:transform(\"$state_dir/up.sh\" \"$state_dir\")" \
    --bind "alt-left:transform(\"$state_dir/up.sh\" \"$state_dir\")" \
    --bind "ctrl-f:transform(\"$state_dir/toggle.sh\" \"$state_dir\")" \
    --bind "ctrl-a:execute(vlm-annotate {+2})+refresh-preview" \
    --bind "ctrl-y:execute-silent(bash -c '$clip_cmd' _ {+2})" \
    --bind "ctrl-o:execute-silent(xdg-open \"\$(dirname {2})\" >/dev/null 2>&1 &)" \
    --bind "ctrl-d:execute(bash -c '$delete_cmd' _ {+2})+reload(\"$state_dir/list.sh\" \"$state_dir\")" \
    --bind "ctrl-r:reload(\"$state_dir/list.sh\" \"$state_dir\")"
}
