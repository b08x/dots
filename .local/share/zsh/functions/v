v() {
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<'HELP'
Usage: v [DIRECTORY]

Interactive video previewer and launcher powered by fd, fzf, kitty/chafa, and mpv.

Keybindings:
  Enter     Play selected video(s) in mpv
  Tab       Select / deselect multiple videos
  Ctrl-D    Delete selected video(s) (with confirmation)
  Ctrl-Y    Copy escaped path(s) to system clipboard
  Ctrl-O    Open parent folder in file manager
  Ctrl-R    Reload video list
  Esc / ^C  Exit
HELP
    return 0
  fi

  local search_dir="${1:-.}"

  # Pure video file extensions (explicitly excluding .ts / .mts to prevent TypeScript code collisions)
  local -a exts=(-e mp4 -e mkv -e webm -e avi -e mov -e m4v -e flv -e wmv -e mpg -e mpeg -e m2ts)

  local fd_cmd="fd -t f ${exts[*]} --search-path \"$search_dir\" --absolute-path"

  local preview_cmd='
    file={}
    [ -f "$file" ] || exit 0

    cols="${FZF_PREVIEW_COLUMNS:-80}"
    lines="${FZF_PREVIEW_LINES:-40}"
    img_lines=$(( lines > 14 ? lines - 7 : lines / 2 ))
    [ "$img_lines" -lt 2 ] && img_lines=2
    dim="${cols}x${img_lines}"

    # Cache thumbnail to speed up fzf navigation
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/fzf-video-previews"
    mkdir -p "$cache_dir" 2>/dev/null
    thumb="$cache_dir/$(printf "%s" "$file" | md5sum | cut -d" " -f1).png"

    if [ ! -s "$thumb" ]; then
      if command -v ffmpegthumbnailer >/dev/null 2>&1; then
        ffmpegthumbnailer -i "$file" -o "$thumb" -s 0 -q 10 -t 15% 2>/dev/null
      fi
      if [ ! -s "$thumb" ] && command -v ffmpeg >/dev/null 2>&1; then
        ffmpeg -nostdin -loglevel error -ss 00:00:03 -i "$file" -frames:v 1 -y "$thumb" 2>/dev/null
      fi
    fi

    # Render image: Native high-res pixel rendering in Kitty via kitten icat, with chafa fallback
    if [ -s "$thumb" ]; then
      rendered=0
      if [[ -n "$KITTY_WINDOW_ID" || "$TERM" == *kitty* ]] && command -v kitty >/dev/null 2>&1; then
        if kitty +kitten icat --clear \
          --use-window-size="${cols},${lines},$(( cols * 10 )),$(( lines * 20 ))" \
          --transfer-mode=file --stdin=no \
          --place="${dim}@0x0" "$thumb" 2>/dev/null; then
          for ((i=0; i<img_lines; i++)); do
            printf "\n"
          done
          rendered=1
        fi
      fi

      if [ "$rendered" -eq 0 ] && command -v chafa >/dev/null 2>&1; then
        chafa -s "$dim" -f symbols --symbols=all --color-space=din99d --work=9 "$thumb" 2>/dev/null
      fi
    fi

    # Subtle divider
    printf "\033[2m"
    printf "─%.0s" $(seq 1 "$cols")
    printf "\033[0m\n"

    # Filename
    printf " \033[1;36m󰕧 \033[1;37m%s\033[0m\n" "${file##*/}"

    # Metadata card
    if command -v mediainfo >/dev/null 2>&1; then
      dur=$(mediainfo --Inform="General;%Duration/String3%" "$file" 2>/dev/null)
      size=$(mediainfo --Inform="General;%FileSize/String3%" "$file" 2>/dev/null)
      res=$(mediainfo --Inform="Video;%Width%x%Height%" "$file" 2>/dev/null)
      vcodec=$(mediainfo --Inform="Video;%Format%" "$file" 2>/dev/null)
      fps=$(mediainfo --Inform="Video;%FrameRate%" "$file" 2>/dev/null)
      acodec=$(mediainfo --Inform="Audio;%Format%" "$file" 2>/dev/null)
      achans=$(mediainfo --Inform="Audio;%Channels/String%" "$file" 2>/dev/null)

      [ -n "$dur" ] && printf " \033[1;33m󰔛\033[0m %-18s \033[1;32m󰉉\033[0m %s\n" "${dur%.*}" "$size"
      [ -n "$res" ] && printf " \033[1;34m󰕦\033[0m %-18s \033[1;35m󰓃\033[0m %s\n" "$res ($vcodec)${fps:+ @ ${fps%.*}fps}" "${acodec:-No audio}${achans:+ ($achans)}"
    elif command -v ls >/dev/null 2>&1; then
      printf " \033[1;32m󰉉\033[0m %s\n" "$(ls -lh "$file" 2>/dev/null | awk "{print \$5}")"
    fi
  '

  local clip_cmd='
    args=()
    for f in "$@"; do
      args+=("$(printf "%q" "$f")")
    done
    str="${args[*]}"
    if command -v wl-copy >/dev/null 2>&1; then
      printf "%s" "$str" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
      printf "%s" "$str" | xclip -selection clipboard
    fi
  '

  local header_str=$'  \e[1;32m󰐊 [Enter]\e[0m Play  \e[1;31m󰆴 [Ctrl-D]\e[0m Delete  \e[1;34m󰅍 [Ctrl-Y]\e[0m Copy Path  \e[1;35m󰝰 [Ctrl-O]\e[0m Folder  \e[1;36m⭮ [Ctrl-R]\e[0m Reload\n'

  eval "$fd_cmd" | fzf \
    --multi \
    --layout=reverse \
    --border=rounded \
    --border-label=" 󰿎 Videos " \
    --border-label-pos=2 \
    --prompt=" 󰿎 Video ❯ " \
    --pointer="▶" \
    --marker="✓" \
    --info=inline-right \
    --header="$header_str" \
    --preview-window="right,55%,border-rounded" \
    --preview-label=" 󰕧 Details " \
    --preview-label-pos=2 \
    --preview "$preview_cmd" \
    --bind "enter:execute(mpv --no-keep-open -- {+})" \
    --bind "ctrl-d:execute(rm -i -- {+})+reload($fd_cmd)" \
    --bind "ctrl-r:reload($fd_cmd)" \
    --bind "ctrl-o:execute-silent(xdg-open \"\$(dirname {})\" >/dev/null 2>&1 &)" \
    --bind "ctrl-y:execute-silent(bash -c '$clip_cmd' _ {+})"
}
