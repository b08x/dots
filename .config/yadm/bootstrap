#!/usr/bin/env bash
# =============================================================================
# YADM Master Bootstrap Orchestrator
# =============================================================================

# --- Error Handling ---
ctrl_c() {
  echo "** End."
  sleep 1
}
trap ctrl_c INT SIGINT SIGTERM ERR EXIT

# --- Colors & UI Components ---
ALL_OFF="\e[1;0m"
BBOLD="\e[1;1m"
BLUE="${BBOLD}\e[1;34m"
GREEN="${BBOLD}\e[1;32m"
RED="${BBOLD}\e[1;31m"
YELLOW="${BBOLD}\e[1;33m"
export GUM_INPUT_WIDTH=0

# Source gum helpers
export GUM_HELPERS_NO_TRAP=1
source "$(dirname "${BASH_SOURCE[0]}")/scripts/gum-helpers.sh"

DISTRO=$(lsb_release -si)

# --- Display Function ---
say() {
  echo -e "${2}${1}${ALL_OFF}" | typewriter
  sleep 1
}


# --- Wipe Screen Function ---
wipe() {
  tput -S <<!
clear
cup 1
!
}

ensure_gum() {
  if [[ ! -x "/usr/bin/gum" ]]; then
    echo "============================================================"
    echo "Installing Gum (TUI Toolkit)"
    echo "============================================================"
    echo "Gum not found. Installing via dnf..."
    if sudo dnf install -y gum; then
      if [[ -x "/usr/bin/gum" ]]; then
        say "Gum installed successfully!" "$GREEN"
        say "Gum version: $(/usr/bin/gum --version)" "$BLUE"
      else
        echo "ERROR: Gum installation failed. Please install manually from https://github.com/charmbracelet/gum"
        exit 1
      fi
    else
      echo "ERROR: Failed to install Gum. This script requires Gum."
      exit 1
    fi
  else
    say "Gum is already installed: $(/usr/bin/gum --version)" "$BLUE"
  fi
}

# --- Display Welcome Message ---
display_welcome_message() {
  wipe
  # Now we can use gum for the rest of the script
  gum style --border normal --margin "1" --padding "1 2" --border-foreground 212 "This bootstrap script is about to configure some stuff. Welcome to $(gum style --foreground 212 'synflow')."
  sleep 1
}


# --- Get Environment Variables ---
get_environment_variables() {
  say "Enter additional environment variables (press Enter with empty input to finish): \n" $BLUE

  declare -A env_vars
  declare var_name=""

  while true; do
    var_name=$(gum input --width=0 --prompt "Variable name (or Enter to finish): ")

    if [[ -z "${var_name}" ]]; then
      break
    else
      var_value=$(gum input --prompt "Value for ${var_name}: ")
      env_vars["${var_name}"]="${var_value}"
    fi
  done

  echo "$env_vars"
}

# --- Pre-flight Check ---
check_drift_and_collisions() {
    section_header "Pre-flight Conflict Detection"
    
    gum log --level info "Checking for configuration drift and potential file collisions..."
    
    local drift_detected=false
    local modified_files
    modified_files=$(yadm status --porcelain 2>/dev/null | sed -n 's/^.[MD] //p')
    
    local alt_targets=()
    for f in $(yadm ls-files 2>/dev/null | grep '##'); do
        local target="${f%%##*}"
        if [[ -n "$target" && -e "$USER_HOME/$target" ]]; then
            alt_targets+=("$target")
        fi
    done

    if [[ -n "$modified_files" ]] || [[ ${#alt_targets[@]} -gt 0 ]]; then
        echo ""
        gum style --foreground "${COLORS[warning]}" --border double --padding "1 2" "WARNING: Configuration Drift or Potential Collisions Detected"
        
        if [[ -n "$modified_files" ]]; then
            echo ""
            gum style --foreground "${COLORS[info]}" "Modified tracked files (local changes may be overwritten):"
            echo "$modified_files" | sed 's/^/  • /'
            drift_detected=true
        fi
        
        if [[ ${#alt_targets[@]} -gt 0 ]]; then
            echo ""
            gum style --foreground "${COLORS[info]}" "Existing host files (may be overwritten by alternates/templates):"
            for t in "${alt_targets[@]}"; do 
                echo "  • $t"
            done
            drift_detected=true
        fi
        
        echo ""
        if [[ "$drift_detected" == true ]]; then
            local action
            action=$(gum choose --header "How would you like to handle these conflicts?" "Backup, Diff & Proceed" "Overwrite & Proceed" "Abort")
            
            case "$action" in
                "Backup, Diff & Proceed")
                    local backup_dir
                    backup_dir=$(mktemp -d "/tmp/yadm_backup_$(date +%s)_XXX")
                    gum log --level info "Backing up conflicting files to $backup_dir"
                    
                    if [[ -n "$modified_files" ]]; then
                        echo "$modified_files" | while read -r f; do
                            if [[ -n "$f" && -e "$USER_HOME/$f" ]]; then
                                mkdir -p "$backup_dir/$(dirname "$f")"
                                cp -a "$USER_HOME/$f" "$backup_dir/$f"
                            fi
                        done
                    fi
                    
                    if [[ ${#alt_targets[@]} -gt 0 ]]; then
                        for t in "${alt_targets[@]}"; do
                            if [[ -n "$t" && -e "$USER_HOME/$t" ]]; then
                                mkdir -p "$backup_dir/$(dirname "$t")"
                                cp -a "$USER_HOME/$t" "$backup_dir/$t"
                            fi
                        done
                    fi
                    
                    gum log --level success "Backup completed successfully."
                    
                    if [[ -n "$modified_files" ]]; then
                        gum log --level info "Generating diff for modified tracked files..."
                        # Use yadm diff with color and pipe to gum pager for a clean TUI experience
                        yadm diff --color=always | gum pager
                    fi
                    
                    if ! gum confirm --prompt.foreground "${COLORS[warning]}" --affirmative "Proceed" --negative "Abort" "Are you sure you want to proceed and overwrite these files?"; then
                        gum log --level error "Bootstrap aborted by user after review."
                        exit 1
                    fi
                    gum log --level info "User opted to proceed after review."
                    ;;
                "Overwrite & Proceed")
                    gum log --level info "User opted to proceed directly."
                    ;;
                "Abort"|*)
                    gum log --level error "Bootstrap aborted by user to handle conflicts manually."
                    exit 1
                    ;;
            esac
        fi
    else
        gum log --level success "No configuration drift or collisions detected."
    fi
}

wipe

term_width=$(tput cols 2>/dev/null || echo 80)

sudo dnf install -y fastfetch && sudo fastfetch

sleep 2

wipe
# --- Main Script ---
# Set up variables
declare -rx USER_HOME="${HOME}"
declare -rx CONFIG_DIR="${USER_HOME}/.config"
LOG_FILE="${USER_HOME}/.bootstrap.log"
mkdir -p "$(dirname "$LOG_FILE")"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Bootstrap script started" > "$LOG_FILE"

ensure_gum

echo $DISTRO && sleep 0.5

display_welcome_message

sleep 1

slide_transition
check_drift_and_collisions

slide_transition
section_header "System Configuration"
gum log --level info "ensuring user shell is set to zsh"

sudo usermod -s /usr/bin/zsh $USER

sleep 1

slide_transition
section_header "Secrets & Credentials"
gum log --level info "decrypting secrets..."

yadm decrypt

sleep 1

gum style --foreground 212 "Bootstrap complete!"

slide_transition
section_header "Templates & Alternates"
say "Checking for Jinja2 template engine (jinjanator)..." $BLUE
if ! command -v j2 &> /dev/null; then
    say "j2 not found. Installing jinjanator via uv..." $YELLOW
    if command -v uv &> /dev/null; then
        uv tool install jinjanator
    else
        say "Error: uv is not installed. Please install uv first to setup templates." $RED
    fi
fi

say "Processing yadm alternates and templates..." $BLUE

yadm alt

slide_transition
section_header "Additional Scripts"
say "Executing additional scripts from bootstrap.d/ ..." $BLUE
BOOTSTRAP_D_DIR="$(dirname "${BASH_SOURCE[0]}")/bootstrap.d"

if [[ -d "$BOOTSTRAP_D_DIR" ]]; then
  mapfile -t scripts < <(find "$BOOTSTRAP_D_DIR" -maxdepth 1 -type f | sort)
  for script in "${scripts[@]}"; do
    if [[ -x "$script" ]]; then
      gum log --level info "Executing $(basename "$script")..."
      "$script"
    else
      gum log --level warn "Skipping $(basename "$script") (not executable)"
    fi
  done
else
  gum log --level warn "Directory not found: $BOOTSTRAP_D_DIR"
fi

say "Bootstrap complete." $GREEN
