#!/usr/bin/env bash
# =============================================================================
# YADM Master Bootstrap Orchestrator (Syncopated user configuration)
#
# Runs the preflight, shell, decrypt and alternates steps, then every
# executable script in bootstrap.d/ in name order: 01-ansible-pull (system
# playbook, a placeholder for now) first, 91-install-vscode-extensions
# last. A bootstrap.d script returns 0 (ok),
# 1 (failed) or 2 (skipped). A failed step offers retry / skip / abort when
# stdin and stdout are terminals; otherwise it is recorded and bootstrap goes on.
#
# On a terminal, a multi-select menu picks which steps run (all start
# selected). Usage: bootstrap [--all | --only STEP[,STEP...]]
#   --all   run every step without the menu
#   --only  run just the named steps (names as in the step list)
#
# Overrides (used by the bats tests): SYNCOPATED_OS_RELEASE,
# SYNCOPATED_NO_ANIM=1 (skip the typewriter delay),
# SYNCOPATED_FORCE_INTERACTIVE=1 (behave as on a terminal).
# =============================================================================

# shellcheck disable=SC2329  # step functions are invoked indirectly through STEP_CMD
set -uo pipefail

YADM_CONFIG_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "$YADM_CONFIG_DIR/scripts/syncopated-theme.sh"

RC_ABORT=3 # internal: the user aborted inside a step
BOOTSTRAP_D_DIR=$YADM_CONFIG_DIR/bootstrap.d
LOG_FILE=${HOME}/.bootstrap.log
USER_NAME=${USER:-$(id -un)}

declare -A STEP_CMD=()
declare -A STEP_LABEL=()
SELECTED=()
OPT_ALL=0
OPT_ONLY=()

# --- helpers -----------------------------------------------------------------

restore_terminal() {
  [[ -t 1 ]] || return 0
  stty echo 2>/dev/null
  tput sgr0 2>/dev/null
  tput cnorm 2>/dev/null
  return 0
}

log_line() {
  local msg="$*" prio="info"
  if [[ $msg == *" failed"* || $msg == *"with failures"* || $msg == *"aborted"* ]]; then
    prio="err"
  elif [[ $msg == *"started"* || $msg == *"finished"* || $msg == *" ok"* ]]; then
    prio="notice"
  fi
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$msg" >>"$LOG_FILE"
  systemd_cat_log "$prio" "$msg"
}

interactive() {
  [[ -n ${SYNCOPATED_FORCE_INTERACTIVE:-} ]] || [[ -t 0 && -t 1 ]]
}

usage() {
  printf 'Usage: bootstrap [--all | --only STEP[,STEP...]]\n' >&2
}

parse_args() {
  local list
  while (($#)); do
    case $1 in
      --all) OPT_ALL=1 ;;
      --only)
        (($# >= 2)) || {
          usage
          exit 2
        }
        list=$2
        shift
        IFS=, read -r -a OPT_ONLY <<<"$list"
        ;;
      --only=*) IFS=, read -r -a OPT_ONLY <<<"${1#--only=}" ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        err "Unknown option: $1"
        usage
        exit 2
        ;;
    esac
    shift
  done
}

ensure_gum() {
  have_gum && return 0
  info "Installing gum (TUI toolkit) with dnf"
  if command -v dnf >/dev/null 2>&1 && sudo dnf install -y gum && have_gum; then
    ok "gum installed: $(gum --version)"
  else
    warn "gum is not available; continuing with plain output. Install it from https://github.com/charmbracelet/gum"
  fi
  return 0
}

# --- steps -------------------------------------------------------------------

# Prompt about tracked-file drift and host files that alternates would replace.
check_drift_and_collisions() {
  local SYNCOPATED_STEP=preflight
  info "Checking for configuration drift and potential file collisions"

  local modified_files=() alt_targets=() f target action backup_dir
  mapfile -t modified_files < <(yadm status --porcelain 2>/dev/null | sed -n 's/^.[MD] //p')
  while IFS= read -r f; do
    target=${f%%##*}
    [[ -n $target && -e $HOME/$target ]] && alt_targets+=("$target")
  done < <(yadm ls-files 2>/dev/null | grep '##')

  if ((${#modified_files[@]} == 0 && ${#alt_targets[@]} == 0)); then
    ok "No configuration drift or collisions detected"
    return "$RC_OK"
  fi

  warn "Configuration drift or potential collisions detected"
  if ((${#modified_files[@]})); then
    info "Modified tracked files (local changes may be overwritten):"
    printf '  • %s\n' "${modified_files[@]}"
  fi
  if ((${#alt_targets[@]})); then
    info "Existing host files (may be overwritten by alternates/templates):"
    printf '  • %s\n' "${alt_targets[@]}"
  fi

  if interactive; then
    action=$(choose "How would you like to handle these conflicts?" \
      "Backup, Diff & Proceed" "Overwrite & Proceed" "Abort") || action=Abort
  else
    action="Backup & Proceed"
  fi

  case $action in
    "Backup, Diff & Proceed" | "Backup & Proceed")
      backup_dir=$(mktemp -d "/tmp/yadm_backup_$(date +%s)_XXX")
      info "Backing up conflicting files to $backup_dir"
      for f in "${modified_files[@]}" "${alt_targets[@]}"; do
        if [[ -n $f && -e $HOME/$f ]]; then
          mkdir -p "$backup_dir/$(dirname "$f")"
          cp -a "$HOME/$f" "$backup_dir/$f"
        fi
      done
      ok "Backup completed"
      if [[ $action == "Backup, Diff & Proceed" ]]; then
        if ((${#modified_files[@]})) && have_gum; then
          yadm diff --color=always | gum pager
        fi
        if [[ $(choose "Proceed and overwrite these files?" Proceed Abort) != Proceed ]]; then
          err "Bootstrap aborted after review"
          return "$RC_ABORT"
        fi
      fi
      ;;
    "Overwrite & Proceed")
      info "Proceeding without a backup"
      ;;
    *)
      err "Bootstrap aborted to handle conflicts manually"
      return "$RC_ABORT"
      ;;
  esac
  return "$RC_OK"
}

step_shell() {
  local SYNCOPATED_STEP=shell
  local login zsh_path
  login=$(getent passwd "$USER_NAME" | cut -d: -f7)
  if [[ $login == *zsh ]]; then
    info "Login shell is already $login"
    return "$RC_SKIPPED"
  fi
  zsh_path=$(command -v zsh) || {
    err "zsh is not installed"
    return "$RC_FAILED"
  }
  info "Setting the login shell to $zsh_path"
  sudo usermod -s "$zsh_path" "$USER_NAME" || return "$RC_FAILED"
  ok "Login shell set to $zsh_path"
}

step_decrypt() {
  local SYNCOPATED_STEP=decrypt
  info "Decrypting secrets"
  local rc=0
  if have_systemd_cat; then
    yadm decrypt 2>&1 | tee >(systemd_cat_log info)
    rc=${PIPESTATUS[0]}
  else
    yadm decrypt
    rc=$?
  fi
  ((rc == 0)) || return "$RC_FAILED"
  ok "Secrets decrypted"
}

step_alternates() {
  local SYNCOPATED_STEP=alternates
  info "Checking for the Jinja2 template engine (jinjanator)"
  if ! command -v j2 >/dev/null 2>&1; then
    if ! command -v uv >/dev/null 2>&1; then
      err "uv is not installed; install it to set up templates"
      return "$RC_FAILED"
    fi
    info "j2 not found; installing jinjanator with uv"
    local uv_rc=0
    if have_systemd_cat; then
      uv tool install jinjanator 2>&1 | tee >(systemd_cat_log info)
      uv_rc=${PIPESTATUS[0]}
    else
      uv tool install jinjanator
      uv_rc=$?
    fi
    ((uv_rc == 0)) || return "$RC_FAILED"
  fi
  info "Processing yadm alternates and templates"
  local alt_rc=0
  if have_systemd_cat; then
    yadm alt 2>&1 | tee >(systemd_cat_log info)
    alt_rc=${PIPESTATUS[0]}
  else
    yadm alt
    alt_rc=$?
  fi
  ((alt_rc == 0)) || return "$RC_FAILED"
  ok "Alternates processed"
}

# --- runner ------------------------------------------------------------------

# step_title SCRIPT : bootstrap.d/10-zsh.sh -> zsh
step_title() {
  local name
  name=$(basename "$1" .sh)
  printf '%s\n' "${name#[0-9]*-}"
}

register_step() {
  STEPS+=("$1")
  STEP_CMD[$1]=$2
  STEP_LABEL[$1]=$(step_label "$1")
}

discover_scripts() {
  local script
  [[ -d $BOOTSTRAP_D_DIR ]] || {
    warn "Directory not found: $BOOTSTRAP_D_DIR"
    return 0
  }
  while IFS= read -r script; do
    if [[ -x $script ]]; then
      register_step "$(step_title "$script")" "$script"
    else
      warn "Skipping $(basename "$script") (not executable)"
    fi
  done < <(find "$BOOTSTRAP_D_DIR" -maxdepth 1 -type f | sort)
}

# show_steps : draw the step list unless it is identical to the last one
# drawn (the last step's redraw and the final report would repeat it).
DRAWN_STATES=
show_steps() {
  local states
  states=$(declare -p STEP_STATE)
  [[ $states == "$DRAWN_STATES" ]] && return 0
  DRAWN_STATES=$states
  draw_steps
}

report() {
  local step state ok_n=0 skipped_n=0 failed_n=0 pending_n=0
  for step in "${STEPS[@]}"; do
    case ${STEP_STATE[$step]:-pending} in
      ok) ok_n=$((ok_n + 1)) ;;
      skipped) skipped_n=$((skipped_n + 1)) ;;
      failed) failed_n=$((failed_n + 1)) ;;
      *) pending_n=$((pending_n + 1)) ;;
    esac
  done
  show_steps
  state="$ok_n ok · $skipped_n skipped · $failed_n failed"
  ((pending_n)) && state+=" · $pending_n not run"
  if ((failed_n)); then
    err "Bootstrap finished with failures: $state"
  else
    ok "Bootstrap finished: $state"
  fi
  log_line "Bootstrap finished: $state"
  ((failed_n == 0))
}

finish() {
  local rc=0
  report || rc=1
  restore_terminal
  exit "$rc"
}

# run_step NAME : run the command registered for NAME, record the state, redraw.
run_step() {
  local name=$1 rc choice
  export SYNCOPATED_STEP=$name
  while :; do
    "${STEP_CMD[$name]}"
    rc=$?
    case $rc in
      "$RC_OK") STEP_STATE[$name]=ok ;;
      "$RC_SKIPPED") STEP_STATE[$name]=skipped ;;
      *) STEP_STATE[$name]=failed ;;
    esac
    log_line "$name ${STEP_STATE[$name]}"

    if ((rc == RC_ABORT)); then
      finish
    elif [[ ${STEP_STATE[$name]} == failed ]] && interactive; then
      err "$name failed"
      choice=$(choose "$name failed" retry skip abort) || choice=skip
      case $choice in
        retry) continue ;;
        abort) finish ;;
      esac
    fi
    break
  done
  export SYNCOPATED_STEP="bootstrap"
  show_steps
}

# validate_only : exit 2 when --only names a step that does not exist.
validate_only() {
  local name bad=()
  for name in "${OPT_ONLY[@]}"; do
    [[ -n ${STEP_CMD[$name]:-} ]] || bad+=("$name")
  done
  ((${#bad[@]} == 0)) && return 0
  err "Unknown step(s): ${bad[*]}"
  printf 'Valid steps: %s\n' "${STEPS[*]}" >&2
  exit 2
}

# select_steps : fill SELECTED with the steps to run, in step order. --only
# filters, --all and non-interactive runs keep every step, and a terminal
# gets the multi-select menu. A cancelled menu selects nothing.
select_steps() {
  local step label picked=() chosen=() labels=()
  SELECTED=()
  if ((${#OPT_ONLY[@]})); then
    for step in "${STEPS[@]}"; do
      [[ " ${OPT_ONLY[*]} " == *" $step "* ]] && SELECTED+=("$step")
    done
  elif ((OPT_ALL)) || ! interactive; then
    SELECTED=("${STEPS[@]}")
  else
    for step in "${STEPS[@]}"; do
      labels+=("${STEP_LABEL[$step]}")
    done
    mapfile -t picked < <(choose_many "Select the steps to run" "${labels[@]}")
    for step in "${STEPS[@]}"; do
      for label in "${picked[@]}"; do
        [[ $label == "${STEP_LABEL[$step]}" ]] && chosen+=("$step")
      done
    done
    SELECTED=("${chosen[@]}")
  fi
}

# needs_sudo : true when a selected step runs sudo. Scripts declare it with a
# "# bootstrap: needs-sudo" line; the shell step always needs it.
needs_sudo() {
  local step
  for step in "${SELECTED[@]}"; do
    [[ $step == shell ]] && return 0
    [[ -f ${STEP_CMD[$step]} ]] && grep -q '^# bootstrap: needs-sudo' "${STEP_CMD[$step]}" && return 0
  done
  return 1
}

on_interrupt() {
  echo
  err "Interrupted"
  finish
}

# --- main --------------------------------------------------------------------

main() {
  parse_args "$@"
  export SYNCOPATED_STEP="bootstrap"
  mkdir -p "$(dirname "$LOG_FILE")"
  log_line "Bootstrap script started"
  trap on_interrupt INT TERM
  trap restore_terminal EXIT

  register_step preflight check_drift_and_collisions
  register_step shell step_shell
  register_step decrypt step_decrypt
  register_step alternates step_alternates
  discover_scripts
  validate_only

  ensure_gum
  splash
  banner
  show_steps

  select_steps
  if ((${#SELECTED[@]} == 0)); then
    info "nothing selected, exiting"
    log_line "Nothing selected"
    exit 0
  fi

  # gum spin hides stdin, so authenticate before any spinner starts.
  if interactive && needs_sudo; then
    sudo -v || warn "sudo authentication failed; steps that need it may fail"
  fi

  local step
  for step in "${SELECTED[@]}"; do
    run_step "$step"
  done
  finish
}

main "$@"
